API(mkdir) API(chdir) API(getcwd) API(stat) API(fstat) API(isatty)
API(opendir) API(readdir) API(closedir)

// POSIX（os/libc/posix.c。Monocs にプロセスはないので getpid・kill・popen は形だけ）、locale.h、wchar.h
API(access) API(lstat) API(realpath) API(utime) API(statvfs) API(clock_gettime) API(clock_settime) API(settimeofday) API(nanosleep) API(getentropy)
API(getpid) API(kill) API(popen) API(pclose)
// シグナル（os/libc/signal.c）。sigemptyset などは signal.h のインライン関数
API(signal) API(sigaction) API(raise) API(sigprocmask) API(sigpending) API(sigsuspend) API(pause) API(psignal)
API(getline) API(getdelim) API_AS(setlocale, app_setlocale) API(wcwidth)
API(strcasestr) API(basename) API(dirname)  // picolibc（string.h の GNU、libgen.h）
// マルチバイト文字（UTF-8。os/libc/mbchar.c）。MB_CUR_MAX は __locale_mb_cur_max() を呼ぶマクロ
API(mbrtowc) API(mbrlen) API(mbtowc) API(mblen) API(wcrtomb) API(wctomb) API(mbstowcs) API(wcstombs) API(mbsinit)
API(__locale_mb_cur_max)

// Linux のプログラムがよく使う関数（2026-11-14）。picolibc のもの（宣言がヘッダーの規格の条件で隠れるものは
// API_EXT）と、Monocs のもの（環境変数: os/libc/env.c、usleep: posix.c、glob: os/libc/glob.c）
API(getopt) API_EXT(getopt_long) API_EXT(getopt_long_only) API(optarg) API(optind) API(opterr) API(optopt)
API_AS(setenv, app_setenv) API_AS(unsetenv, app_unsetenv) API_AS(putenv, app_putenv)
API(sleep) API(usleep)
API(strsep) API(stpcpy) API(stpncpy) API(strlcpy) API(strlcat) API_EXT(memmem) API_EXT(memrchr)
API_EXT(strchrnul) API_EXT(strverscmp) API(strsignal) API(explicit_bzero) API(bzero) API(bcopy)
API(index) API(rindex) API(ffs)
API_AS(strerror_r, gnu_strerror_r) API_EXT(__xpg_strerror_r)    // GNU 版と POSIX 版（ヘッダーが _GNU_SOURCE で選ぶ）
API(asprintf) API(vasprintf) API(dprintf) API(vdprintf) API(open_memstream) API(fmemopen)
API_AS(qsort_r, gnu_qsort_r) API_EXT(__bsd_qsort_r)            // GNU 版と BSD 版（ヘッダーが _GNU_SOURCE で選ぶ）
API(reallocarray) API(getsubopt) API(mkstemp) API(tmpnam) API(tmpfile) API(localeconv) API(strcoll) API(strxfrm)
API(flockfile) API(funlockfile) API(ftrylockfile) API(getc_unlocked) API(putc_unlocked) API(getchar_unlocked) API(putchar_unlocked) API(fseeko) API(ftello)   // POSIX（Lua の LUA_USE_POSIX）
API(random) API(srandom) API(rand_r) API(drand48) API(srand48) API(lrand48)
API(ctime) API(ctime_r) API(asctime) API(asctime_r) API_AS(timegm, app_timegm) API_EXT(strptime) API(tzset)
API_EXT(fnmatch) API_EXT(glob) API_EXT(globfree)
API_EXT(regcomp) API_EXT(regexec) API_EXT(regerror) API_EXT(regfree)
