// OS API の関数表に載せるシンボル（アプリから呼べるもの）
// API(名前)      : ヘッダーで宣言されている関数・変数
// API_EXT(名前)  : ヘッダーにない関数（libgcc の補助関数など）
// API_AS(名前, 実体) : アプリから見える名前と、カーネル側の関数が異なるもの
// API_TLS(名前)  : _Thread_local の変数（アプリからは TP からのオフセットで参照する。run.c の resolve）

// stdio.h
API(stdin) API(stdout) API(stderr)
API(printf) API(fprintf) API(sprintf) API(snprintf)
API(vprintf) API(vfprintf) API(vsprintf) API(vsnprintf)
API(scanf) API(fscanf) API(sscanf) API(vscanf) API(vfscanf) API(vsscanf)
API(puts) API(fputs) API(putchar) API(fputc) API(putc)
API(getchar) API(fgetc) API(getc) API(fgets) API(ungetc)
API(fopen) API(fdopen) API(freopen) API(fclose) API(fread) API(fwrite) API_AS(fflush, app_fflush)
API(fseek) API(ftell) API(rewind) API(fgetpos) API(fsetpos)
API(feof) API(ferror) API(clearerr) API(fileno)
API(remove) API(rename) API(perror) API(setvbuf) API(setbuf)

// stdlib.h
API(malloc) API(calloc) API(realloc) API(free)
API(atoi) API(atol) API(atoll) API(atof)
API(strtol) API(strtoul) API(strtoll) API(strtoull) API(strtod) API(strtold) API(strtof)
API(abs) API(labs) API(llabs) API(div) API(ldiv) API(lldiv)
API(qsort) API(bsearch) API(rand) API(srand)
API_AS(system, shell_system) API_AS(exit, app_exit_with_handlers) API(_Exit) API(abort) API_AS(atexit, app_atexit) API(getenv)

