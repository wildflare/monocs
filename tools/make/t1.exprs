$(CC)
$(CFLAGS)
$(LATE)
$(NOW)
$(OBJS)
$(PAT)
$(UNSET)
[$(space)]
$(subst $(space),$(comma),$(SRCS))
$(patsubst %.c,%.o,$(SRCS))
$(strip   a   b  c )
$(findstring b,abc)/$(findstring z,abc)
$(filter %.c sub/%,$(SRCS) x.h)
$(filter-out a.c,$(SRCS))
$(sort $(LIST))
$(word 2,$(LIST))/$(words $(LIST))/$(firstword $(LIST))/$(lastword $(LIST))
$(wordlist 2,3,$(LIST))
$(dir $(SRCS) top)
$(notdir $(SRCS))
$(suffix $(SRCS) noext)
$(basename $(SRCS) sub/x.tar.gz)
$(addsuffix .bak,$(SRCS))
$(join a b c,1 2)
$(if $(X),yes,no)/$(if $(empty),yes,no)
$(or $(empty),second)/$(and a,b,last)/[$(and a,$(empty),c)]
$(foreach f,$(SRCS),<$(f)>)
$(call reverse,A,B)
$(value LATE)
$(origin X)/$(origin UNDEFINED_THING)
$(BR) $(BR2) [$(D)] $(ND) $(SH)
$(TWO_LINES)
$(EXPORTED) $(OVR)
$(ALL_C)
$($(NESTED_NAME:A=NESTED_A))
${SRCS} $(URL)
